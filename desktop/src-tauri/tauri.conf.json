{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hi-EV",
  "version": "0.1.0",
  "identifier": "com.hiev.desktop",
  "build": {
    "beforeBuildCommand": "cd ../web && npm run build",
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "Hi-EV",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": true,
        "fullscreen": false,
        "resizable": true,
        "visible": false
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": false,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "dmg", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "© 2026 Hi-EV",
    "category": "Productivity",
    "shortDescription": "Personal AI operating system",
    "longDescription": "Hi-EV is a local-first personal AI operating system with native desktop presence, voice, and memory."
  }
}
