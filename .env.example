# Default: local SQLite with sqlite-vec (no Postgres install required).
# For Postgres + pgvector, use: postgresql://localhost:5432/hiev
EV_DATABASE_URL=sqlite+aiosqlite:///%USERPROFILE%/.hiev/hiev.db
EV_REDIS_URL=redis://localhost:6379/0
EV_PERSONAL_ONLY=true
EV_NOTES_PATH=/path/to/your/notes
EV_GITHUB_TOKEN=ghp_xxxxxxxx

# Personal-only boundary: handles/domains that EV must never ingest (JSON array).
EV_BLOCKED_HANDLES=["financialsimplicity"]
EV_BLOCKED_DOMAINS=["financialsimplicity.com"]

# Local embedding model for semantic memory (offline, runs on your RTX 5060 laptop).
EV_EMBEDDING_MODEL=all-MiniLM-L6-v2

# LLM provider (default: nvidia)
EV_LLM_PROVIDER=nvidia
EV_LLM_MODEL=meta/llama-3.2-11b-vision-instruct
EV_NVIDIA_API_KEY=nvapi-xxxxxxxx
EV_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional fallbacks
EV_ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
EV_OPENAI_API_KEY=sk-xxxxxxxx

# Google integration (read-only)
EV_GOOGLE_ENABLED=false
EV_GOOGLE_CREDENTIALS_PATH=/path/to/credentials.json

# Alert loop (background deadline digests)
EV_ALERT_INTERVAL_SEC=900
EV_ALERT_WINDOW_HOURS=72
EV_QUIET_START=22:00
EV_QUIET_END=08:00
EV_KILL_SWITCH=false

# Local repo paths for Claude Code spawn
EV_ROBOCAD_PATH=C:/Users/point/projects/RoboCAD
EV_LEARNINGROBOTICS_PATH=C:/Users/point/projects/LearningRobotics
EV_HIEV_PATH=C:/Users/point/projects/Hi-EV

# Optional: override the web client daemon target (defaults to localhost:7345)
# VITE_EV_WS_URL=ws://127.0.0.1:7345/ws
# VITE_EV_API_URL=http://127.0.0.1:7345
